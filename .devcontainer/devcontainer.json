{
    "name": "Ros2 Astar",
    "image": "osrf/ros:lyrical-desktop",
    "updateContentCommand": "rosdep update && rosdep install --from-paths src --ignore-src -r -y",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-iot.vscode-ros",
                "ms-vscode.cpptools",
                "twxs.cmake"
            ]
        }
    },
    "runArgs": ["--net=host","--ipc=host"],
    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}"
    },
    "mounts": [
        {
            "source": "/tmp/.X11-unix",
            "type": "bind",
            "target": "/tmp/.X11-unix"
        }
    ],
    "workspaceFolder": "/wokspaces/ros2_ws",
    "remoteUser": "root"
}